[gpg]
	format = ssh

[merge]
    conflictstyle = zdiff3

[user]
	email = veyxov@gmail.com
	name = Shekhov Ismoil
	signingkey = ~/.ssh/id_ed25519.pub
[push]
    autoSetupRemote = true
    followTags = true
[init]
    defaultBranch = main
[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    dft = -c diff.external=difft diff
    dlog = -c diff.external=difft log -p --ext-diff
[diff]
    colorMoved = zebra
    algorithm = histogram
[core]
	pager = git-delta-theme
	excludesfile = ~/.config/git/ignore
[interactive]
	diffFilter = git-delta-theme --color-only
[delta]
	navigate = true
	line-numbers = true
[rebase]
	autosquash = true
	updateRefs = true
	autoStash = true
[fetch]
	prune = true
[help]
	autocorrect = 20
[pull]
    rebase = true

[commit]
	gpgsign = true
[credential]
	useHttpPath = true
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
