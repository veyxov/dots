;; imperial44 keymap (qmk/.../ergohaven/imperial44/keymaps/veyxov) ported onto
;; the MacBook internal keyboard.
;;
;; Physical mapping: row shift + virtual split-gap (skip y/u, g/h/j) so the
;; laptop mimics the split board. Letters live one row up from their qwerty
;; position; bottom letter row is the thumb row.
;;
;;   1    2 3 4 5 6   |  7  8 9 0 - = bspc     row1: num! j f m p v | Scrn x . / ? ' _
;;   tab  q w e r t   |  i o p [ ] ret         row2: del  r s n d w | , a e i h :
;;   caps a s d f     |  k l ; ' \  rsft       row3: x g l c b | - u o y k ·
;;   z  x c v b  spc  n m , .                  z=Cmd, thumbs: REP NAV/t SYM/spc TAB | LOCK CTL/left SYM/spc ALT/right (spacebar = one-shot Shift)
;;
;; lsft stays native shift (imperial has none; zero-cost safety net).
;; Known deviations from QMK: no alt-repeat (Ctrl+REP), PV->LV uses a
;; backspace rewrite (p already typed), adaptive prior-key is kanata's
;; emitted-output history (a letter typed via combo/macro also counts; QMK
;; likewise treats a rewrite's output as the prior), the LTNAV repeat-guard
;; only looks one input back (T right after REP), one-shots expire after
;; 65.5s (kanata max; QMK never).
;; FN/CRYL layers removed (matches QMK); media/volume/brightness already
;; come from the Mac's native F-row hardware keys, untouched by kanata's
;; defsrc, so nothing was lost by dropping the FN layer.

(defcfg
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
  concurrent-tap-hold yes
  process-unmapped-keys yes ;; y/u/g/h/j etc. pass through; needed so smous can see physical Opt/Cmd/Ctrl
)

(defsrc
  grv  nubs
  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    i    o    p    [    ]    ret
  caps a    s    d    f    k    l    ;    '    \    rsft
  z    x    c    v    b    spc  n    m    ,    .
  lmet
)

;; One adaptive-key case: fire $out when the previous emitted key was $prior
;; within 200ms (ADAPTIVE_TERM) and no mods are held (QMK guard).
(deftemplate adapt (prior out)
  ((and (key-timing 1 less-than 200) (key-history $prior 1)
        (not lctl) (not rctl) (not lalt) (not ralt) (not lmet) (not rmet)))
  $out break)

;; numw key that also leaves numword
(deftemplate ex (k) (multi $k (layer-switch base)))

(defalias
  ;; layer holds / one-shots
  osl    (one-shot 65535 (layer-while-held num))         ;; OSL(_NUM)
  ;; T straight after REP stays a plain tap (QMK repeat-guard); input-history
  ;; recency 2 = previous input, 1 is this press. x is the physical REP key.
  ltnav  (switch ((input-history real x 2)) t break
                 () (tap-hold 0 200 t (layer-while-held nav)) break) ;; LT(_NAV, KC_T)
  symspc (tap-hold 0 200 spc (layer-while-held sym))   ;; LT(_SYM, KC_SPC)
  ;; Spacebar is one-shot Shift, but a real Space when any other mod is held
  ;; (Opt+Space launcher, Cmd+Space, Ctrl+Space).
  ;; Cmd tap opens the launcher (Vorssaint command bar = Opt+Space); hold stays Cmd
  cmdl   (tap-hold-press 0 200 A-spc lmet)
  smous  (switch ((or lalt ralt lmet rmet lctl rctl)) spc break
                 () (one-shot 65535 lsft) break)         ;; OSM(MOD_LSFT)

  ;; thumb row
  ;; HOLD_ON_OTHER_KEY_PRESS for the arrow mod-taps (fast Alt+M rolls)
  ctlleft (tap-hold-press 0 200 left lctl)             ;; MT(MOD_LCTL, KC_LEFT)
  altrght (tap-hold-press 0 200 rght lalt)             ;; MT(MOD_LALT, KC_RGHT)
  lock    C-M-q                                          ;; macOS native Lock Screen (was Cmd+L, clashed w/ browser addr bar)
  scrn    M-C-S-4                                        ;; macOS region screenshot to clipboard

  ;; monitor toggle/move (macOS shortcuts, same as QMK MON_TOG/MON_MOV)
  montog M-C-rght
  monmov M-C-S-rght

  ;; NUMWORD: switches the base layer to numw, whose non-numeric keys fall
  ;; back to base (QMK allowlist: digits . - + bspc rep). Chord toggles it off.
  exnw    (layer-switch base)                             ;; leave numword (no-op elsewhere)
  numword (switch ((layer numw)) (layer-switch base) break
                  () (layer-switch numw) break)

  ;; custom shift keys (QMK custom_shift_keys[])
  fdot  (fork . S-grv (lsft rsft))          ;; . -> ~
  fslsh (fork / S-7 (lsft rsft))            ;; / -> &
  fques (fork S-/ S-1 (lsft rsft))          ;; ? -> !
  fcomm (fork , S-\ (lsft rsft))            ;; , -> |
  funds (fork S-- (unshift grv) (lsft rsft)) ;; _ -> `
  fmins (fork - S-= (lsft rsft))            ;; - -> +
  fcoln (fork S-; (unshift ;) (lsft rsft))  ;; : -> ;

  ;; adaptive keys (adaptive.h) via the adapt template. key-history matches
  ;; kanata's OUTPUT history: recency 1 = previous emitted key (the current
  ;; press is not in history yet), named by output keycode — NOT physical
  ;; input position. Base layer only (QMK gates adaptive to _BASE).
  am  (switch (t! adapt f l) (t! adapt v l) (t! adapt p l) () m break) ;; FM/VM/PM -> .L
  ap  (switch (t! adapt f S-[) () p break)                    ;; FP -> F{ (as QMK codes it)
  av  (switch (t! adapt m b)                                  ;; MV -> MB
              (t! adapt p (macro bspc l v)) () v break)       ;; PV -> LV (p already typed)
  add (switch (t! adapt d c) () d break)                      ;; DD -> DC
  ac  (switch (t! adapt l p) () c break)                      ;; LC -> LP
  al  (switch (t! adapt l m) () l break)                      ;; LL -> LM
  ag  (switch (t! adapt g f) () g break)                      ;; GG -> GF
  ax  (switch (t! adapt g s) () x break)                      ;; GX -> GS
  ah  (switch (t! adapt u a) (t! adapt a u)                   ;; UH -> UA, AH -> AU
              (t! adapt o e) (t! adapt e o) () h break)       ;; OH -> OE, EH -> EO
)

;; combos (combos.def), 20ms COMBO_TERM. Keys are physical inputs; each
;; chord is disabled on layers where QMK remaps its keys away from the
;; combo's keycodes. (p [) covers both ei_enter and fnc "()"->enter.
(defchordsv2
  (4 5)   (multi z @exnw)              20 first-release (nav sym)                       ;; mp -> z
  (2 3)   (multi q @exnw)              20 first-release (nav sym)                       ;; jf -> q
  (3 4)   (multi (macro q u) @exnw)    20 first-release (nav sym)                       ;; fm -> "qu"
  (p [)   ret            20 first-release (nav num numw)                                ;; ei -> enter, () -> enter
  (w e)   esc            20 first-release (nav sym num numw)                            ;; sn -> esc
  (w r)   C-spc          20 first-release (nav sym num numw)                            ;; sd -> lang switch (ctrl+space)
  (e r)   tab            20 first-release (nav sym num numw)                            ;; nd -> tab
  (o p)   A-bspc         20 first-release (nav sym num numw)                            ;; ae -> word-bspc
  (a s)   (multi M-c @exnw)            20 first-release (nav sym)                       ;; gl -> copy
  (s d)   M-v            20 first-release (nav sym num numw)                            ;; lc -> paste (num: c is 8)
  (a s d) M-a            20 first-release (nav sym num numw)                            ;; glc -> select all (num: c is 8)
  (o p [) ;              20 first-release (nav sym num numw)                            ;; aei -> ;
  (, c)   (caps-word-toggle 5000) 20 first-release (nav sym num numw)                   ;; caps word, sym/spc + nav/t
  (v spc) @numword       20 first-release (nav sym)                                     ;; sym/spc + shift -> numword toggle
  (0 -)   pgup           20 first-release (nav sym num numw)                            ;; / ? -> pgup
  (- =)   (multi pgdn @exnw)           20 first-release (nav sym)                       ;; ? ' -> pgdn
  (0 p)   (macro = S-.)  20 first-release (nav sym num numw)                            ;; /e -> "=>"
)

(deflayer base
  grv  grv
  @osl   j    f    @am  @ap  @av  @scrn   x     @fdot  @fslsh @fques '       @funds
  del    r    s    n    @add w    @fcomm a   e      i      @ah    @fcoln
  @ax    @ag  @al  @ac  b    @fmins u   o    y      k      XX
  @cmdl rpt  @ltnav @symspc tab @smous @lock @ctlleft @symspc @altrght
  @cmdl
)

(deflayer nav
  grv  grv
  @osl   j    A-f  m    A-p  A-v  @scrn   x     A-1    A-2    A-3    A-4     @funds
  del    M-S-s lalt lsft lctl lmet home left  down   up     rght   end
  x      M-S-g A-n  C-z  C-S-z @fmins A-c M-spc A-k  @montog @monmov
  @cmdl rpt  @ltnav M-S-spc tab @smous @lock M-S-s M-S-spc M-S-c
  @cmdl
)

(deflayer num
  grv  grv
  @osl   j    f    m    p    v    @scrn   x     @fdot  S-=    @fques '       @funds
  del    6    4    0    2    w    @fcomm 3   1      5      7      @fcoln
  x      g    l    8    b    @fmins 9   o    y      k      XX
  @cmdl rpt  bspc spc tab @smous @lock .    spc -
  @cmdl
)

;; NUMWORD layer, same keys as num; anything outside QMK's allowlist (digits
;; . - + bspc rep) is sent and drops back to base.
(deflayer numw
  grv  grv
  (t! ex @osl) (t! ex j) (t! ex f) (t! ex m) (t! ex p) (t! ex v) (t! ex @scrn) (t! ex x) @fdot S-= (t! ex @fques) (t! ex ') (t! ex @funds)
  (t! ex del)  6    4    0    2    (t! ex w) (t! ex @fcomm) 3   1      5      7      (t! ex @fcoln)
  (t! ex x) (t! ex g) (t! ex l) 8 (t! ex b) @fmins 9 (t! ex o) (t! ex y) (t! ex k) XX
  (t! ex @cmdl) rpt bspc (t! ex spc) (t! ex tab) (t! ex @smous) (t! ex @lock) . (t! ex spc) -
  @cmdl
)

(deflayer sym
  grv  grv
  @osl   '    S-,  S-.  S-'  v    @scrn   @fdot S-7    ]      [      S-5     @funds
  del    S-1  @fmins S-= =   S-3  0    ;     S-0    S-9    S-4    @fcoln
  S-6    @fslsh S-2 \   b    S-grv S-8 S-]   S-[    S-2    XX
  @cmdl bspc spc  @symspc tab  ret @lock @ctlleft @symspc @altrght
  @cmdl
)
