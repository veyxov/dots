pane_frames false
default_layout "compact"
scrollback_editor "nvim"
theme_dark "rose-pine"
theme_light "rose-pine-dawn"

keybinds {
    shared_except "locked" {
        bind "Alt n" { NewTab; }
        bind "Alt a" { GoToPreviousTab; }
        bind "Alt e" { GoToNextTab; }
        bind "Alt d" { NewPane "Down"; }
        bind "Alt s" { NewPane "Right"; }
        bind "Alt l" { FocusNextPane; }
        bind "Alt m" { MovePane; }
        bind "Alt x" { CloseFocus; }
        bind "Alt t" { EditScrollback; }
        bind "Alt z" { ToggleFocusFullscreen; }

        // Ctrl-o clashes with neovim/claude code; move session mode off it
        unbind "Ctrl o"
        bind "Ctrl Alt o" { SwitchToMode "Session"; }
    }
    session {
        unbind "Ctrl o"
        bind "Ctrl Alt o" { SwitchToMode "Normal"; }
    }
}
