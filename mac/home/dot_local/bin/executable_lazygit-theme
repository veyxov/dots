#!/usr/bin/env bash
# lazygit on macOS reads ~/Library/Application Support, so point it at ~/.config and add the theme matching current appearance
dir="$HOME/.config/lazygit"
if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = "Dark" ]; then
  theme=dark
else
  theme=light
fi
LG_CONFIG_FILE="$dir/config.yml,$dir/theme-$theme.yml" exec lazygit "$@"
