#!/bin/bash
file="/tmp/brew_pkg_list"
# refresh daily so new formulae show up without a reboot clearing /tmp
if [ -z "$(find "$file" -mtime -1 2>/dev/null)" ]; then
    echo "Creating cache..."
    { brew formulae; brew casks; } > "$file"
fi

if [ $# -eq 0 ]; then
    fzf --multi --no-height --preview 'brew info {1}' < "$file" | xargs -ro brew install
else
    brew install "$@"
fi
